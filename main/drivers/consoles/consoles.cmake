# consoles.cmake - consoles.mk for CMake (the CYD's main/CMakeLists.txt and the
# RP2040 / RP2350's): CONSOLES, and cons_sources(<id> <var> <prefix>) the
# console's sources (CONS_COMMON + CONS_SRC_<id>) with <prefix> before each.
file(STRINGS ${CMAKE_CURRENT_LIST_DIR}/consoles.mk _cons_lines)
set(CONSOLES)
foreach(_l ${_cons_lines})
    if(_l MATCHES "^CONSOLES :=(.*)$")
        string(STRIP "${CMAKE_MATCH_1}" _v)
        string(REPLACE " " ";" CONSOLES "${_v}")
    endif()
endforeach()
function(cons_sources id var prefix)
    set(_out)
    foreach(_l ${_cons_lines})
        if(_l MATCHES "^(CONS_COMMON|CONS_SRC_${id}) :=(.*)$")
            string(STRIP "${CMAKE_MATCH_2}" _v)
            string(REPLACE " " ";" _v "${_v}")
            foreach(_s ${_v})
                list(APPEND _out ${prefix}${_s})
            endforeach()
        endif()
    endforeach()
    set(${var} ${_out} PARENT_SCOPE)
endfunction()
# cons_var(<name> <var>): another line of consoles.mk (CONS_RAM_<id>: the
# objects the RP2040 / RP2350 runs from RAM), as a list
function(cons_var name var)
    set(_out)
    foreach(_l ${_cons_lines})
        if(_l MATCHES "^${name} :=(.*)$")
            string(STRIP "${CMAKE_MATCH_1}" _v)
            string(REPLACE " " ";" _out "${_v}")
        endif()
    endforeach()
    set(${var} ${_out} PARENT_SCOPE)
endfunction()
