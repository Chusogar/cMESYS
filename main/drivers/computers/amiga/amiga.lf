# Hot code in RAM (the RP2350's flash cache is shared with the PSRAM): the 68000 handlers
# measured hottest on the Amiga 500 (Kickstart 1.3 booting, Shadow of the Beast's loader and
# intro, North & South: 99% of the instructions run), for tools/pico_hot.py
[mapping:amiga_hot]
archive: libmain.a
