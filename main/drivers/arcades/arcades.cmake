# arcades.cmake - arcades.mk for CMake (the CYD's main/CMakeLists.txt and the
# RP2040 / RP2350's): ARCADES, and arc_sources(<id> <var> <prefix>) the
# game's sources (ARC_COMMON + ARC_SRC_<id>) with <prefix> before each.
file(STRINGS ${CMAKE_CURRENT_LIST_DIR}/arcades.mk _arc_lines)
set(ARCADES)
foreach(_l ${_arc_lines})
    if(_l MATCHES "^ARCADES :=(.*)$")
        string(STRIP "${CMAKE_MATCH_1}" _v)
        string(REPLACE " " ";" ARCADES "${_v}")
    endif()
endforeach()
function(arc_sources id var prefix)
    set(_out)
    foreach(_l ${_arc_lines})
        if(_l MATCHES "^(ARC_COMMON|ARC_SRC_${id}) :=(.*)$")
            string(STRIP "${CMAKE_MATCH_2}" _v)
            string(REPLACE " " ";" _v "${_v}")
            foreach(_s ${_v})
                list(APPEND _out ${prefix}${_s})
            endforeach()
        endif()
    endforeach()
    set(${var} ${_out} PARENT_SCOPE)
endfunction()
# arc_var(<name> <var>): another line of arcades.mk (ARC_RAM_<id>: the
# objects the RP2040 / RP2350 runs from RAM; ARC_DEFS_<id>: the defines), as a list
function(arc_var name var)
    set(_out)
    foreach(_l ${_arc_lines})
        if(_l MATCHES "^${name} :=(.*)$")
            string(STRIP "${CMAKE_MATCH_1}" _v)
            string(REPLACE " " ";" _out "${_v}")
        endif()
    endforeach()
    set(${var} ${_out} PARENT_SCOPE)
endfunction()
