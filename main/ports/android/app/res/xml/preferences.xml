<?xml version="1.0" encoding="utf-8"?>
<!-- The settings of every machine (after its own, res/xml/machine.xml). -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/pc_display">
        <ListPreference android:key="scale" android:title="@string/pref_scale" android:summary="%s"
            android:entries="@array/scale_entries" android:entryValues="@array/scale_values" android:defaultValue="fit43" />
        <CheckBoxPreference android:key="smooth" android:title="@string/pref_smooth"
            android:summary="@string/pref_smooth_sum" android:defaultValue="true" />
        <CheckBoxPreference android:key="show_leds" android:title="@string/pref_leds" android:defaultValue="true" />
        <CheckBoxPreference android:key="show_fps" android:title="@string/pref_fps" android:defaultValue="false" />
        <CheckBoxPreference android:key="corner_buttons" android:title="@string/pref_corner" android:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/pc_input">
        <CheckBoxPreference android:key="keyboard_start" android:title="@string/pref_kb_start" android:defaultValue="true" />
        <CheckBoxPreference android:key="keyboard_overlay" android:title="@string/pref_kb_overlay"
            android:summary="@string/pref_kb_overlay_sum" android:defaultValue="false" />
        <ListPreference android:key="keyboard_alpha" android:title="@string/pref_kb_alpha" android:summary="%s"
            android:entries="@array/alpha_entries" android:entryValues="@array/alpha_values" android:defaultValue="85" />
        <CheckBoxPreference android:key="haptic" android:title="@string/pref_haptic" android:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/pc_sound">
        <CheckBoxPreference android:key="sound" android:title="@string/pref_sound" android:defaultValue="true" />
    </PreferenceCategory>
</PreferenceScreen>
