<?xml version="1.0" encoding="utf-8"?>
<!-- The settings of this machine (MachineActivity / SettingsActivity: then res/xml/preferences.xml). -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/pc_system">
        <CheckBoxPreference android:key="fast_load" android:title="Carga rápida de disco"
            android:summary="LOAD desde el .d64 al momento (si no, a la velocidad de la 1541)" android:defaultValue="true" />
        <CheckBoxPreference android:key="autoload_last" android:title="@string/pref_autoload"
            android:summary="@string/pref_autoload_sum" android:defaultValue="false" />
        <ListPreference android:key="pad" android:title="@string/pref_pad" android:summary="%s"
            android:entries="@array/pad_entries" android:entryValues="@array/pad_values" android:defaultValue="joy2" />
    </PreferenceCategory>
</PreferenceScreen>
