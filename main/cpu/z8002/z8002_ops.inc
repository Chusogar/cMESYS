{
    uint32_t result = dest + value;
    CLR_CZSV;       /* first clear C, Z, S, P/V flags          */
    CHK_XXXL_ZS;    /* set Z and S flags for result long       */
    CHK_ADDX_C;     /* set C if result overflowed              */
    CHK_ADDL_V;     /* set V if result has incorrect sign      */
    return result;
}

