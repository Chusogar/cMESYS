/******************************************
 multiply words
 flags:  CZSV--
 ******************************************/
static uint32_t MULTW(uint16_t dest, uint16_t value)
{
    uint32_t result = (int32_t)(int16_t)dest * (int16_t)value;
    CLR_CZSV;
    CHK_XXXL_ZS;
    if(!value)
    {
        /* multiplication with zero is faster */
        m_icount += (70-18);
    }
    if((int32_t)result < -0x7fff || (int32_t)result >= 0x7fff) SET_C;
    return result;
}

/******************************************
 multiply longs
