static uint8_t NEGB(uint8_t dest)
{
    uint8_t result = (uint8_t) -dest;
    CLR_CZSV;
    CHK_XXXB_ZS;    /* set Z and S flags for result byte       */
    if (result > 0) SET_C;
    if (result == S08) SET_V;
    return result;
}

/******************************************
 negate word
 flags:  CZSV--
 ******************************************/
static uint16_t NEGW(uint16_t dest)
{
    uint16_t result = (uint16_t) -dest;
    CLR_CZSV;
    CHK_XXXW_ZS;    /* set Z and S flags for result word       */
    if (result > 0) SET_C;
    if (result == S16) SET_V;
    return result;
}

